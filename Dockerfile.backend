# Dockerfile.backend — Продакшен образ FastAPI бэкенда ТЕЛЕМАСТЕР
FROM python:3.12-slim

# Установка переменных окружения для оптимизации Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Создание непривилегированного пользователя для безопасности (hardening)
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -d /app -s /sbin/nologin appuser

# Установка зависимостей
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копирование исходного кода
COPY backend/ .

# Создание директории для SQLite БД и назначение прав
RUN mkdir -p /app/data && chown -R appuser:appuser /app

# Переключение на непривилегированного пользователя
USER appuser

# Healthcheck без внешних утилит — использует встроенную библиотеку urllib
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/healthz')" || exit 1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
