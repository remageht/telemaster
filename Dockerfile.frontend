# Dockerfile.frontend — Статический Nginx сервер для фронтенда ТЕЛЕМАСТЕР
FROM nginx:alpine

# Удаляем дефолтный конфиг nginx
RUN rm /etc/nginx/conf.d/default.conf

# Копируем наш оптимизированный конфиг
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Копируем статические файлы фронтенда
COPY index.html manifest.json robots.txt sitemap.xml sw.js /usr/share/nginx/html/
COPY css/ /usr/share/nginx/html/css/
COPY js/ /usr/share/nginx/html/js/
COPY img/ /usr/share/nginx/html/img/

# Настройка прав для непривилегированного доступа
RUN chown -R nginx:nginx /usr/share/nginx/html

HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/ > /dev/null || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
