# Окружение: production | development
ENVIRONMENT=production

# Секретный ключ для подписи JWT (минимум 32 символа в продакшене!)
# Сгенерировать: openssl rand -hex 32 или python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-32-chars

# Время жизни JWT токенов
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# База данных (SQLite по умолчанию, для PostgreSQL: postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./telemaster.db

# Разрешенные CORS источники (через запятую)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://localhost

# Лимит запросов (slowapi): по умолчанию 20 в минуту на IP адрес
RATE_LIMIT_DEFAULT=20/minute

# Telegram уведомления о новых заказах и лидах (опционально)
# Бот: @BotFather -> токен; ID чата: @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
